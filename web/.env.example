# Copy this file to .env.local and fill in the values from the Supabase dashboard.

# ---- Browser (public). Only the publishable (anon) key goes here. ----
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# ---- Server only (/api/*). NEVER prefix these with VITE_. ----
SUPABASE_URL=https://<project-ref>.supabase.co
# Supabase > Project Settings > API Keys > secret key (sb_secret_...) or legacy service_role (eyJ...)
SUPABASE_SERVICE_ROLE_KEY=

# One AI key is enough. If several are set, Gemini wins, then OpenAI, then Anthropic.
GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Optional
# GEMINI_MODEL=gemini-2.5-flash
# OPENAI_MODEL=gpt-4.1
# ANTHROPIC_MODEL=claude-sonnet-5-5
# QUESTION_COUNT=10
